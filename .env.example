MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=banking
MYSQL_USER=bankapp
MYSQL_PASSWORD=change-me

DB_HOST=mysql
DB_NAME=banking
DB_USER=bankapp
DB_PASSWORD=change-me

AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Optional: raises NVD API rate limits (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=

# Session signing key (generate: python -c "import secrets;print(secrets.token_hex(32))")
FLASK_SECRET_KEY=change-me
# 1 enables the Werkzeug debugger (never on a reachable host)
FLASK_DEBUG=0
# Review threshold 0-1; empty uses the model default (0.5)
MOBILE_RISK_THRESHOLD=
# API clients as name:sha256(key), comma-separated (create: python -m mobile_risk.apikeys new <name>)
BLUEWATCH_API_KEYS=

# Free local AI via Ollama: AI_PROVIDER=ollama (AI_MODEL defaults to qwen2.5:1.5b)
# Claude instead: AI_PROVIDER=anthropic and AI_API_KEY=<key>
OLLAMA_URL=
